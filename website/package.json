{
  "name": "ipas-practice",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .open-next",
    "build:sites": "node scripts/patch-opennext.mjs && npm run validate:content && opennextjs-cloudflare build && node scripts/package-next.mjs",
    "test": "node scripts/patch-opennext.mjs && node --experimental-strip-types --test tests/*.test.* components/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@opennextjs/cloudflare": "1.20.9",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  },
  "type": "module"
}
